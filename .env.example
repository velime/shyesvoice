# Optional legacy bootstrap file — the recommended way to configure the bot
# is the Setup screen in the dashboard (it writes to config.json instead).
# If a config.json doesn't exist yet, these values are auto-migrated in on
# first run. Copy this file to .env only if you prefer editing files by hand.
DISCORD_TOKEN=your-discord-bot-token
TARGET_USER_ID=123456789012345678
TTS_VOICE=uk-UA-OstapNeural
FLASK_PORT=5000
